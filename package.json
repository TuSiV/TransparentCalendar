{
  "name": "transparent-outlook-calendar",
  "version": "1.0.0",
  "description": "桌面透明日历插件，接入 Outlook 日历",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-packager . TransparentCalendar --platform=win32 --arch=x64 --out=dist --overwrite --icon=assets/app.ico --ignore=\"node_modules/electron-packager|node_modules/electron-builder|node_modules/app-builder|\\\\.git|dist\"",
    "dist": "electron-builder --win --x64"
  },
  "dependencies": {
    "@azure/msal-node": "^2.16.2",
    "ical.js": "^2.2.1"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^26.15.3",
    "electron-packager": "^17.1.2"
  },
  "build": {
    "appId": "com.transparent.calendar",
    "productName": "TransparentCalendar",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/app.ico",
      "assets/tray.png"
    ],
    "win": {
      "icon": "assets/app.ico",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "assets/app.ico",
      "uninstallerIcon": "assets/app.ico",
      "artifactName": "${productName}-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "${productName}.exe"
    }
  }
}
